rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Returns true only if the signed-in user's email exists in allowedUsers
    function isAllowed() {
      return request.auth != null
          && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email));
    }

    // Returns true for anonymous Firebase auth users
    function isAnonymous() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // allowedUsers — managed from the Firebase Console only.
    // Each document ID is the user's email address.
    // Users can read their own doc (so the app can check access),
    // but nobody can write from the client.
    match /allowedUsers/{email} {
      allow read:  if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }

    // savedBooks — shared library visible to all allowed users.
    // Anonymous (guest) users may read but not write.
    match /savedBooks/{docId} {
      allow read:           if isAllowed() || isAnonymous();
      allow create:         if isAllowed();
      allow update, delete: if isAllowed();
    }

    // guestScans — rate-limit counters for anonymous users.
    // Each document ID is the anonymous UID.
    // Writes happen server-side (Admin SDK), but allow client reads/writes
    // for the user's own document as specified.
    match /guestScans/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
